<Window x:Class="WdbgToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Debug Toolkit"
        Icon="Assets/Wdt.ico"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17243A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65738A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2864DC" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E7EF" />
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ScenarioItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Padding="16"
                                Background="White"
                                BorderBrush="#E2E7EF"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#2864DC" />
                                <Setter TargetName="Card" Property="Background" Value="#F8FAFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#8AA9E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17243A">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2864DC">
                        <TextBlock Text="W"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Windows Debug Toolkit"
                               Margin="12,0,0,0"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="36,30,36,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                    <TextBlock Text="DIAGNOSTICS WORKSPACE"
                               Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Start with the problem."
                               Margin="0,10,0,0"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="SCENARIOS"
                               Margin="0,0,0,12"
                               Style="{StaticResource SectionLabel}" />
                    <ListBox Grid.Row="1"
                             x:Name="ScenarioList"
                             ItemsSource="{Binding}"
                             SelectedIndex="0"
                             SelectionChanged="ScenarioList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,6,0"
                             ItemContainerStyle="{StaticResource ScenarioItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34"
                                            CornerRadius="9"
                                            Background="#EDF2FC"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Padding="8,4"
                                            CornerRadius="9"
                                            Background="#F0F2F6"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="PLANNED"
                                                   Foreground="#647187"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2"
                            Margin="0,16,6,0"
                            Padding="18"
                            Background="White"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="PACKAGE MANAGER SETUP"
                                       Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Install Chocolatey using WinGet"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Needed for tools such as Npcap and ProcDump. Run the toolkit as administrator to install."
                                       Margin="0,6,0,12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                            <Button x:Name="InstallChocolateyButton"
                                    Content="Install Chocolatey"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Padding="12,7"
                                    Click="InstallChocolateyButton_Click" />
                            <TextBlock x:Name="ChocolateySetupStatus"
                                       Text="Checking package managers..."
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Padding="24"
                        Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SELECTED SCENARIO"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock x:Name="SelectedScenarioName"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Choose a scenario" />
                        <TextBlock x:Name="SelectedScenarioDescription"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />

                        <Border Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource LineBrush}" />

                        <TextBlock Text="TOOLS IN THE PLAN"
                                   Style="{StaticResource SectionLabel}" />
                        <ItemsControl x:Name="ScenarioTools" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="•"
                                                   Margin="0,0,9,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="15" />
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="13" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                CornerRadius="9"
                                Background="#F4F7FD">
                            <StackPanel>
                                <TextBlock Text="Workflow actions run real local commands"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Each action below runs the relevant command (cdb, wpr, dumpcap, tshark, or PowerShell) and writes artifacts plus a manifest.json under %ProgramData%\WdbgToolkit\&lt;scenario&gt;\&lt;timestamp&gt;\ — the same format the companion MCP server will read."
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           LineHeight="17"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="16"
                                Background="#FAFBFD"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="PREREQUISITES"
                                           Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="PrerequisiteTitle"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="PrerequisiteDescription"
                                           Margin="0,5,0,10"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           LineHeight="16"
                                           TextWrapping="Wrap" />
                                <DockPanel x:Name="PackageManagerControls" LastChildFill="True">
                                    <Button x:Name="RefreshPackageManagersButton"
                                            DockPanel.Dock="Right"
                                            Content="Refresh"
                                            Margin="8,0,0,0"
                                            Padding="10,7"
                                            Click="RefreshPackageManagersButton_Click" />
                                    <ComboBox x:Name="PackageManagerSelector"
                                              MinHeight="34"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="PackageManagerSelector_SelectionChanged"
                                              IsEnabled="False" />
                                </DockPanel>
                                <TextBlock x:Name="PackageManagerStatus"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <Button x:Name="InstallPrerequisitesButton"
                                        Margin="0,12,0,0"
                                        Padding="14,10"
                                        IsEnabled="False"
                                        Click="InstallPrerequisitesButton_Click"
                                        Background="{StaticResource AccentBrush}"
                                        BorderThickness="0"
                                        Foreground="White"
                                        FontWeight="SemiBold" />
                                <TextBlock x:Name="InstallationStatus"
                                           Margin="0,9,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="16"
                                Background="#FAFBFD"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="WORKFLOW ACTIONS"
                                           Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="WorkflowActionsEmptyNotice"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           LineHeight="16"
                                           TextWrapping="Wrap"
                                           Text="No workflow actions are defined yet for this scenario."
                                           Visibility="Collapsed" />
                                <ItemsControl x:Name="WorkflowActionsList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    Padding="12"
                                                    Background="White"
                                                    BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource InkBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Margin="0,4,0,8"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11"
                                                               LineHeight="15"
                                                               TextWrapping="Wrap" />
                                                    <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0,0,0,8"
                                                             Padding="6"
                                                             ToolTip="{Binding ParameterHint}"
                                                             Visibility="{Binding HasParameter, Converter={StaticResource BoolToVisibility}}"
                                                             Tag="{Binding ParameterHint}" />
                                                    <Button Content="Run"
                                                            HorizontalAlignment="Left"
                                                            Padding="12,7"
                                                            Click="RunWorkflowActionButton_Click"
                                                            Background="{StaticResource AccentBrush}"
                                                            BorderThickness="0"
                                                            Foreground="White"
                                                            FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="WorkflowActionStatus"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="McpServerSection"
                                Margin="0,14,0,0"
                                Padding="16"
                                Background="#FAFBFD"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="MCP SERVER"
                                           Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="McpServerStatus"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           LineHeight="16"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="StartMcpServerButton"
                                            Content="Start server"
                                            Padding="14,8"
                                            Click="StartMcpServerButton_Click"
                                            Background="{StaticResource AccentBrush}"
                                            BorderThickness="0"
                                            Foreground="White"
                                            FontWeight="SemiBold" />
                                    <Button x:Name="StartMcpServerAsAdminButton"
                                            Content="Start as admin"
                                            Margin="10,0,0,0"
                                            Padding="14,8"
                                            Click="StartMcpServerAsAdminButton_Click"
                                            Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            Foreground="{StaticResource InkBrush}" />
                                    <Button x:Name="StopMcpServerButton"
                                            Content="Stop server"
                                            Margin="10,0,0,0"
                                            Padding="14,8"
                                            IsEnabled="False"
                                            Click="StopMcpServerButton_Click"
                                            Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            Foreground="{StaticResource InkBrush}"
                                            FontWeight="SemiBold" />
                                </WrapPanel>
                                <TextBlock Text="Add to your MCP client config (VS Code mcp.json and Claude/Cursor-style mcpServers)"
                                           Margin="0,14,0,6"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBox x:Name="McpServerDetails"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="320"
                                         Background="White"
                                         BorderBrush="{StaticResource LineBrush}" />
                                <Button x:Name="CopyMcpServerDetailsButton"
                                        Content="Copy"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Padding="14,8"
                                        IsEnabled="False"
                                        Click="CopyMcpServerDetailsButton_Click"
                                        Background="White"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        Foreground="{StaticResource InkBrush}"
                                        FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Height="1"
                                Margin="0,22,0,16"
                                Background="{StaticResource LineBrush}" />
                        <TextBlock Text="THIS DEVICE"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock x:Name="DeviceInfo"
                                   Margin="0,9,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,22,0,0"
                                Padding="16"
                                Background="#FAFBFD"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="MACHINE SETUP"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SectionLabel}" />
                                <TextBlock Margin="0,8,0,12"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           LineHeight="16"
                                           TextWrapping="Wrap"
                                           Width="220"
                                           Text="Install every tool required across all diagnostic scenarios in one step." />
                                <Button x:Name="DebugMachineSetupButton"
                                        Content="Debug Machine Setup"
                                        HorizontalAlignment="Right"
                                        Padding="18,11"
                                        Click="DebugMachineSetupButton_Click"
                                        Background="{StaticResource AccentBrush}"
                                        BorderThickness="0"
                                        Foreground="White"
                                        FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
        </Grid>
    </Grid>
</Window>
