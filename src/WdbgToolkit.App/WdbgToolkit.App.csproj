<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WdbgToolkit.Core\WdbgToolkit.Core.csproj" />
    <ProjectReference Include="..\WdbgToolkit.PackageManagement\WdbgToolkit.PackageManagement.csproj" />
    <ProjectReference Include="..\WdbgToolkit.Workflows\WdbgToolkit.Workflows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Wdt.ico</ApplicationIcon>
    <StartupObject>WdbgToolkit.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <Resource Include="Assets\Wdt.ico" />
  </ItemGroup>

</Project>
